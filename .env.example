OPENROUTER_API_KEY=
OPENROUTER_MODEL_CLINICAL=google/gemini-3.8-flash
OPENROUTER_MODEL_VISION=google/gemini-2.5-pro
OPENROUTER_MODEL_FAST=google/gemini-3.8-flash
# Fixed output: 1536 dimensions; use the matching query/document ingestion pipeline.
OPENROUTER_MODEL_EMBEDDING=google/gemini-embedding-2

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Password for /knowledge (licensed NCSF materials in private bucket "ncsf"). Use a long one.
NCSF_ACCESS_PASSWORD=

NCBI_EMAIL=
NCBI_API_KEY=

# Public website origin for canonical and social image URLs when self-hosting.
# Set to the actual HTTPS domain; Vercel provides its production hostname automatically.
SITE_URL=
