      "css": ".ds-badge{display:inline-flex;align-items:center;gap:6px;padding:5px 9px;border:1px solid var(--rule);border-radius:6px;font-size:11px;line-height:1.5;font-weight:500;color:var(--ink);font-family:var(--font-body),ui-sans-serif,system-ui,sans-serif;}"
