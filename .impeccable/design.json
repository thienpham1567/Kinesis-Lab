      "html": "<nav class=\"ds-nav\" aria-label=\"Điều hướng di động\"><a href=\"#consult\" aria-current=\"page\"><svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.5Z M8 9h8 M8 13h5\"/></svg><span>Tư vấn</span></a><a href=\"#atlas\"><svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 3v18M3 6l5-3 8 3 5-3v15l-5 3-8-3-5 3V6ZM8 3v15M16 6v15\"/></svg><span>Atlas</span></a></nav>",
      "css": ".ds-nav{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:4px;padding:6px 8px;border-top:1px solid var(--rule);background:color-mix(in srgb,var(--sheet) 94%,var(--canvas));backdrop-filter:blur(12px);box-shadow:0 -4px 20px color-mix(in srgb,var(--ink) 8%,transparent);font-family:var(--font-body),ui-sans-serif,system-ui,sans-serif;}.ds-nav a{display:flex;flex-direction:column;min-height:48px;align-items:center;justify-content:center;gap:4px;border-radius:12px;font-size:12px;line-height:16px;font-weight:600;color:var(--slate);text-decoration:none;transition:color 150ms,background-color 150ms}.ds-nav a:hover{background:var(--surface);color:var(--ink)}.ds-nav a[aria-current=\"page\"]{background:var(--cobalt-soft);color:var(--cobalt)}.ds-nav a:focus-visible{outline:3px solid var(--cobalt);outline-offset:3px;}"
    },
    {
      "name": "Badge",
