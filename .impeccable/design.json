      "description": "Shared primary action, including disabled and keyboard states.",
      "html": "<button class=\"ds-primary\">Lưu thay đổi</button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:10px 16px;border-radius:10px;font-size:13px;line-height:1.5;font-weight:600;cursor:pointer;transition:background 150ms,border-color 150ms,box-shadow 150ms;font-family:var(--font-body),ui-sans-serif,system-ui,sans-serif;background:var(--cobalt);color:var(--on-cobalt);border:1px solid var(--cobalt);box-shadow:0 2px 3px color-mix(in srgb,var(--cobalt) 18%,transparent)}.ds-primary:hover:not(:disabled){background:var(--ink);border-color:var(--ink);color:var(--on-cobalt)}.ds-primary:focus-visible{outline:3px solid var(--cobalt);outline-offset:3px;}.ds-primary:disabled{background:var(--surface);color:var(--slate);border-color:var(--rule);box-shadow:none;cursor:not-allowed}"
