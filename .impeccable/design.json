      "html": "<div class=\"ds-tabs\"><button class=\"ds-tab\" aria-pressed=\"true\">Tổng quan</button><button class=\"ds-tab\" aria-pressed=\"false\">Nguồn</button></div>",
      "css": ".ds-tabs{display:flex;flex-wrap:wrap;gap:6px;border:1px solid var(--rule);border-radius:14px;background:color-mix(in srgb,var(--surface) 88%,var(--sheet));padding:5px;box-shadow:inset 0 1px 2px color-mix(in srgb,var(--ink) 6%,transparent)}.ds-tab{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:10px 15px;min-height:44px;border:1px solid transparent;border-radius:10px;font-size:12.5px;font-weight:600;color:var(--slate);background:transparent;cursor:pointer;transition:background 150ms,border-color 150ms,box-shadow 150ms,color 150ms;font-family:var(--font-body),ui-sans-serif,system-ui,sans-serif;}.ds-tab:hover{color:var(--ink);background:color-mix(in srgb,var(--sheet) 70%,transparent)}.ds-tab[aria-pressed=\"true\"]{color:var(--ink);background:var(--sheet);border-color:color-mix(in srgb,var(--mark) 35%,var(--rule));box-shadow:inset 0 -2px 0 var(--mark),0 1px 2px color-mix(in srgb,var(--ink) 8%,transparent),0 3px 8px -2px color-mix(in srgb,var(--cobalt) 16%,transparent)}.ds-tab:focus-visible{outline:3px solid var(--cobalt);outline-offset:3px;}"
