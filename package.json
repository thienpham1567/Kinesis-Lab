{
  "name": "pt-medical-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:landing": "node scripts/check-landing.mjs",
    "check:markdown": "node scripts/check-markdown-answer.mjs",
    "check:safety": "node --experimental-strip-types src/lib/clinical/safety.check.ts",
    "check:rom": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/lib/clinical/rom-norms.check.ts",
    "check:atlas-render": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-atlas-render-policy.mjs",
    "check:atlas-learning": "node --test scripts/check-atlas-learning-studio.mjs",
    "check:atlas-study": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-hip-material-study.mjs",
    "check:atlas-detail": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-tissue-detail.mjs",
    "check:atlas-corrections": "node scripts/check-atlas-medical-corrections.mjs",
    "check:atlas-evidence": "node scripts/check-atlas-evidence.mjs",
    "check:atlas-context": "node scripts/check-contextual-anatomy.mjs && node scripts/check-anatomy-load.mjs",
    "check:atlas-names": "node scripts/check-atlas-names.mjs",
    "check:atlas-search": "node --test scripts/check-atlas-search-highlight.mjs",
    "rea": "bash scripts/rea.sh",
    "check:ncsf-quiz": "node scripts/check-ncsf-quiz.mjs && node scripts/ncsf-coverage.mjs",
    "check:training-observation": "node --experimental-transform-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/check-training-observation.mjs",
    "evidence:prepare": "node scripts/ingest-evidence.mjs --prepare",
    "evidence:import": "node scripts/ingest-evidence.mjs --apply",
    "check:chat": "node --test scripts/check-ai-runtime.mjs scripts/check-chat-stream.mjs scripts/check-rag-runtime.mjs scripts/check-evidence-import.mjs scripts/check-chat-route.mjs && node scripts/check-evidence-coverage.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "next": "16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "react-pdf": "^11.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.186.1",
    "three-mesh-bvh": "0.9.16",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "fast-xml-parser": "^5.11.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
