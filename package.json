{
  "name": "pt-medical-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "design:check": ".agents/skills/impeccable/scripts/impeccable detect src/",
    "design:check:page": ".agents/skills/impeccable/scripts/impeccable detect",
    "check:ui": "node --test scripts/check-client-workflows.mjs scripts/check-client-status.mjs scripts/check-reading-position.mjs scripts/check-ncsf-study-continuity.mjs scripts/check-consult-scroll.mjs scripts/check-atlas-loading.mjs",
    "check:markdown": "node scripts/check-markdown-answer.mjs",
    "check:safety": "node --experimental-strip-types src/lib/clinical/safety.check.ts",
    "check:rom": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/lib/clinical/rom-norms.check.ts",
    "check:atlas-render": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-atlas-render-policy.mjs",
    "check:atlas-labels": "node --test scripts/check-atlas-callouts.mjs",
    "check:atlas-learning": "node --test scripts/check-atlas-learning-studio.mjs",
    "check:atlas-study": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-hip-material-study.mjs",
    "check:atlas-detail": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-tissue-detail.mjs",
    "check:atlas-corrections": "node scripts/check-atlas-medical-corrections.mjs",
    "check:atlas-geometry": "node --test scripts/check-atlas-geometry-quality.mjs && node scripts/audit-atlas-geometry-quality.mjs --check",
    "check:catalog-audit": "node --test scripts/check-catalog-evidence-audit.mjs && node scripts/audit-catalog-evidence.mjs --check",
    "check:atlas-evidence": "node scripts/check-atlas-evidence.mjs",
    "check:structure-anatomy": "node --test scripts/check-structure-anatomy-evidence.mjs",
    "check:atlas-context": "node scripts/check-contextual-anatomy.mjs && node scripts/check-anatomy-load.mjs",
    "check:atlas-names": "node scripts/check-atlas-names.mjs",
    "check:atlas-search": "node --test scripts/check-atlas-search-highlight.mjs",
    "rea": "bash scripts/rea.sh",
    "check:ncsf-runtime": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/check-ncsf-quiz-runtime.mjs scripts/check-ncsf-coverage.test.mjs",
    "check:ncsf-quiz": "npm run check:ncsf-runtime && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-ncsf-quiz.mjs && node scripts/ncsf-coverage.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/ncsf-figures.mjs",
    "ncsf:figures": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/ncsf-figures.mjs --render",
    "check:training-observation": "node --experimental-transform-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/check-training-observation.mjs",
    "evidence:prepare": "node scripts/ingest-evidence.mjs --prepare",
    "evidence:import": "node scripts/ingest-evidence.mjs --apply",
    "check:study-chat": "node --test scripts/check-study-chat.mjs scripts/check-study-chat-route.mjs scripts/check-pubmed.mjs",
    "check:chat": "node --test scripts/check-ai-runtime.mjs scripts/check-chat-stream.mjs scripts/check-rag-runtime.mjs scripts/check-evidence-import.mjs scripts/check-chat-route.mjs && node scripts/check-evidence-coverage.mjs",
    "check:ncsf-mocks": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/check-ncsf-mock-exams.mjs scripts/check-ncsf-mock-answers.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "next": "16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "react-pdf": "^11.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.186.1",
    "three-mesh-bvh": "0.9.16",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "fast-xml-parser": "^5.11.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
